{
  "expo": {
    "name": "BHCJOBS",
    "slug": "bhcjobs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_day_mode.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_day_mode.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_day_mode.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.turfseeker.bhcjobs"
    },
    "web": {
      "favicon": "./assets/logo_day_mode.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "a28ce5b0-7f0a-4cfa-91e9-3843ceb48a7f"
      }
    }
  }
}
